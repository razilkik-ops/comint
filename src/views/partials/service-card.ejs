<article class="service-card <%= item.category ? 'has-category' : '' %>">
  <% const iconIndex = typeof itemIndex === 'number' ? itemIndex % 6 : 0; %>
  <span class="service-card-icon service-card-icon-<%= iconIndex %>" aria-hidden="true">
    <% if (iconIndex === 0) { %>
      <svg viewBox="0 0 48 48" focusable="false">
        <rect x="10" y="7" width="22" height="34" rx="2" />
        <path d="M18 16h6M18 23h6M18 30h6M36 14h4M36 22h4M36 30h4" />
        <circle cx="21" cy="36" r="2" />
      </svg>
    <% } else if (iconIndex === 1) { %>
      <svg viewBox="0 0 48 48" focusable="false">
        <path d="M8 17h32v22H8z" />
        <path d="m8 17 16 12 16-12M15 13l9-6 9 6" />
      </svg>
    <% } else if (iconIndex === 2) { %>
      <svg viewBox="0 0 48 48" focusable="false">
        <rect x="9" y="13" width="13" height="25" rx="2" />
        <rect x="26" y="8" width="13" height="30" rx="2" />
        <path d="M14 19h3M31 15h3M31 22h3M31 29h3" />
      </svg>
    <% } else if (iconIndex === 3) { %>
      <svg viewBox="0 0 48 48" focusable="false">
        <path d="M6 16h15l4 5h17v19H6z" />
        <path d="M6 16V9h13l4 7" />
      </svg>
    <% } else if (iconIndex === 4) { %>
      <svg viewBox="0 0 48 48" focusable="false">
        <circle cx="20" cy="26" r="10" />
        <circle cx="30" cy="26" r="10" />
        <path d="M22 11c3 2 4 4 4 7M30 10c-3 2-4 4-4 8" />
      </svg>
    <% } else { %>
      <svg viewBox="0 0 48 48" focusable="false">
        <path d="M12 7h21l7 7v27H12z" />
        <path d="M33 7v9h7M18 19h12M18 27h12M18 35h7" />
      </svg>
    <% } %>
  </span>
  <div>
    <% if (item.category) { %>
      <span class="service-badge"><%= item.category %></span>
    <% } %>
    <h3>
      <% if (item.url) { %>
        <a href="<%= item.url %>"><%= item.title %></a>
      <% } else { %>
        <%= item.title %>
      <% } %>
    </h3>
    <p><%= item.description %></p>
  </div>
  <ul>
    <% if (item.params) { %>
      <% item.params.forEach((param) => { %>
        <li><%= param %></li>
      <% }) %>
    <% } %>
    <% if (item.branding) { %>
      <li>Нанесение: <%= item.branding %></li>
    <% } %>
    <% if (item.minOrder) { %>
      <li>Минимальный тираж: <%= item.minOrder %></li>
    <% } %>
  </ul>
  <div class="service-card-actions">
    <% if (item.url) { %>
      <a class="button secondary" href="<%= item.url %>">Подробнее</a>
    <% } %>
    <a class="button outline" href="#lead-form" data-fill-service="<%= item.title %>" data-fill-category="<%= item.category || '' %>">Заявка</a>
  </div>
</article>
