<%- include('../partials/head') %>
<%- include('../partials/header') %>
<%
  const catalogToRender = typeof visibleServiceCatalog !== 'undefined' ? visibleServiceCatalog : serviceCatalog;
  const isSearchMode = typeof searchQuery !== 'undefined' && searchQuery;
  const catalogCardsToRender = isSearchMode ? catalogToRender : catalogToRender.slice(0, 12);
  const serviceCardTitles = {
    print: 'Полиграфия',
    souvenirs: 'Сувенирная продукция',
    stickers: 'Самоклеящаяся продукция',
    outdoor: 'Наружная реклама',
    'large-format': 'Широкоформатная печать',
    exhibitions: 'Оформление выставок',
    calendars: 'Печать и изготовление календарей',
    decor: 'Декор интерьера',
    retail: 'Оформление мест продаж',
    'mobile-equipment': 'Мобильное рекламное оборудование',
    navigation: 'Навигация',
    textile: 'Одежда и текстиль',
    transport: 'Реклама на транспорте'
  };
  const catalogImages = {
    print: '/images/catalog-services/download.png',
    souvenirs: '/images/catalog-services/download-1.png',
    stickers: '/images/catalog-services/download-2.png',
    outdoor: '/images/catalog-services/download-3.png',
    'large-format': '/images/catalog-services/download-4.png',
    exhibitions: '/images/catalog-services/download-5.png',
    calendars: '/images/catalog-services/download-6.png',
    decor: '/images/catalog-services/download-7.png',
    retail: '/images/catalog-services/download-8.png',
    'mobile-equipment': '/images/catalog-services/download-9.png',
    navigation: '/images/catalog-services/download-10.png',
    textile: '/images/catalog-services/download-11.png',
    transport: '/images/catalog-services/download-12.png'
  };
%>

<main class="company-copy-page classic-page classic-catalog-page catalog-redesign">
  <% if (isSearchMode) { %>
    <section class="service-search-summary" aria-live="polite">
      <div class="wrap">
        <p>Результаты поиска по услугам</p>
        <h2><%= searchQuery %></h2>
        <span><%= searchResultCount %> <%= searchResultCount === 1 ? 'услуга найдена' : 'услуг найдено' %></span>
      </div>
    </section>
  <% } %>

  <section class="catalog-redesign-hero" aria-labelledby="catalog-title">
    <div class="catalog-redesign-wrap">
      <div class="catalog-redesign-heading">
        <h1 id="catalog-title">Каталог</h1>
        <p>Выберите направление, чтобы посмотреть услуги и оформить заказ</p>
      </div>

      <div class="catalog-redesign-grid">
        <% if (!catalogToRender.length) { %>
          <div class="service-search-empty">
            <h2>Ничего не нашли</h2>
            <p>Попробуйте другой запрос или откройте полный каталог.</p>
          </div>
        <% } %>
        <% catalogCardsToRender.forEach((category, index) => {
          const categoryItems = createServiceItems(category);
          const cardUrl = category.route || categoryItems[0]?.url || '/services';
          const title = serviceCardTitles[category.slug] ?? category.title;
          const imageSrc = catalogImages[category.slug];
        %>
          <a class="catalog-redesign-card catalog-redesign-card-<%= index % 6 %> catalog-redesign-card-<%= category.slug %>" href="<%= cardUrl %>">
            <span class="catalog-redesign-photo" aria-hidden="true">
              <% if (imageSrc) { %>
                <img class="catalog-redesign-image" src="<%= imageSrc %>" alt="" loading="lazy">
              <% } else { %>
                <span class="catalog-redesign-icon catalog-redesign-icon-<%= category.slug %>"></span>
              <% } %>
            </span>
            <span class="catalog-redesign-title"><%= title %></span>
            <span class="catalog-redesign-arrow" aria-hidden="true">→</span>
          </a>
        <% }) %>
      </div>

    </div>
  </section>
</main>

<%- include('../partials/footer') %>
